{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordle",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-31",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordle-production",
      "database_id": "547883f2-acea-4e4e-b6e3-6b4e007445a9",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/production",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "dev": {
      "name": "wordle-dev",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wordle-dev",
          "migrations_dir": "migrations"
        }
      ],
      "assets": {
        "directory": "./dist/dev",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
