{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordle",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-31",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordle-production",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "env": {
    "dev": {
      "name": "wordle-dev",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wordle-dev",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
